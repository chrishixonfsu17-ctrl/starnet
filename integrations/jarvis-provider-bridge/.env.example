# Copy to a local .env file that is excluded from Git. Never commit real keys.
JARVIS_BRIDGE_ENABLED=false
JARVIS_BRIDGE_TOKEN=replace-with-a-long-random-secret

# Set model IDs from each provider's current documentation.
# Leave a provider's model unset until you have a working API key and verified model ID.
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=

ANTHROPIC_API_KEY=
JARVIS_CLAUDE_MODEL=

GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=

PERPLEXITYAI_API_KEY=
JARVIS_PERPLEXITY_MODEL=

XAI_API_KEY=
JARVIS_GROK_MODEL=

# Optional local StarNet address for a separate, manually configured harness integration.
# This bridge does not guess or call StarNet endpoints.
STARNET_BASE_URL=http://127.0.0.1:8787
